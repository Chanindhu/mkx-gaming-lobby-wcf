<Window x:Class="MKX.Lobby.Client.Duplex.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login (Duplex)" Height="380" Width="740" WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" WindowStyle="SingleBorderWindow" Background="Black">
    <Grid>
        <!-- Background image -->
        <Image Source="/Assets/Login.png"
           Stretch="UniformToFill"
           HorizontalAlignment="Stretch"
           VerticalAlignment="Stretch"
           Panel.ZIndex="0"/>

        <!-- Dark overlay for readability -->
        <Rectangle Fill="#66000000" Panel.ZIndex="1"/>

        <!-- Center login card -->
        <Border Panel.ZIndex="2"
            Background="#CC1E1E1E" CornerRadius="10"
            Padding="20" Width="320" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="MKX Lobby (Duplex)" FontSize="22" FontWeight="Bold"
                   Foreground="White" Margin="0,0,0,12" />
                <TextBlock Text="Username" Foreground="#E0E0E0" />
                <TextBox x:Name="UsernameBox" Margin="0,6,0,14" Height="28" />

                <Button Content="Login"
                Height="32" Width="100" HorizontalAlignment="Right"
                Click="Login_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
