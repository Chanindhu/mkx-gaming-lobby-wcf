<Window x:Class="MKX.Lobby.Client.Duplex.PrivateChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Private Messages"
        Height="560" Width="780"
        WindowStartupLocation="CenterOwner"
        Background="#1B1B1B">

    <!-- Styling (same palette, bigger/cleaner UI) -->
    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#E4B900"/>

        <!-- Rounded yellow button -->
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="12" Background="{TemplateBinding Background}">
                            <Border.Effect>
                                <DropShadowEffect Color="#66000000" BlurRadius="10" ShadowDepth="2"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFF0CB20"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#FFD8B800"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rounded TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#EEE"/>
            <Setter Property="Background" Value="#111"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="#333" BorderThickness="1">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- List items with hover/selected states (pickers/files) -->
        <Style x:Key="SelectableItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bg" CornerRadius="10" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" BorderBrush="Transparent" BorderThickness="1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#1F000000"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#2A000000"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="bg" Property="BorderThickness" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bg" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Chat items: non-selectable / no highlight -->
        <Style x:Key="ChatItemStyle" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Margin" Value="2,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Message & file templates -->
        <DataTemplate x:Key="MessageTemplate">
            <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="14" Foreground="#E0E0E0"/>
        </DataTemplate>

        <DataTemplate x:Key="FileRowTemplate">
            <DockPanel LastChildFill="True">
                <TextBlock Text="Attachment" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" Foreground="#E0E0E0" VerticalAlignment="Center"/>
            </DockPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header: Back + peer -->
        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,10">
            <Button x:Name="BackBtn"
                    Content="Back"
                    Width="100" Height="34"
                    Click="Back_Click"
                    DockPanel.Dock="Left"/>
            <TextBlock x:Name="PeerHeader"
                       Text="Chat"
                       Foreground="#EEEEEE"
                       FontSize="16"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="10,0,0,0"
                       DockPanel.Dock="Left"/>
        </DockPanel>

        <!-- Select view (overlays when visible) -->
        <Border x:Name="SelectView"
                Grid.RowSpan="2"
                CornerRadius="14" Background="#221F1F" Padding="14" BorderBrush="#333" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#AA000000" BlurRadius="12" ShadowDepth="2"/>
            </Border.Effect>
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="Choose a player to message"
                           Foreground="#EEEEEE"
                           FontSize="18"
                           FontWeight="Bold"
                           Margin="2,0,0,10"/>
                <ListBox x:Name="UsersList"
                         MinHeight="260"
                         Background="#151515"
                         Foreground="#E0E0E0"
                         BorderThickness="0"
                         ItemContainerStyle="{StaticResource SelectableItemStyle}"
                         MouseDoubleClick="UsersList_MouseDoubleClick"/>
            </DockPanel>
        </Border>

        <!-- Main area: Chat (left) | Shared Files (right) -->
        <Grid x:Name="ChatView" Grid.Row="1" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <!-- Chat (wider) -->
                <ColumnDefinition Width="12"/>
                <!-- gutter -->
                <ColumnDefinition Width="320"/>
                <!-- Files -->
            </Grid.ColumnDefinitions>

            <!-- Chat panel -->
            <Border Grid.Column="0" Background="#221F1F" Padding="12" CornerRadius="14" BorderBrush="#333" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="#AA000000" BlurRadius="10" ShadowDepth="2"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <!-- messages -->
                        <RowDefinition Height="Auto"/>
                        <!-- input -->
                    </Grid.RowDefinitions>

                    <!-- Messages -->
                    <Border Grid.Row="0" Background="#151515" CornerRadius="10" Margin="0,0,0,10">
                        <ListBox x:Name="List"
                                 Background="Transparent"
                                 Foreground="#E0E0E0"
                                 BorderThickness="0"
                                 ItemTemplate="{StaticResource MessageTemplate}"
                                 ItemContainerStyle="{StaticResource ChatItemStyle}"/>
                    </Border>

                    <!-- Longer input row with placeholder -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="108"/>
                            <!-- Share... -->
                            <ColumnDefinition Width="108"/>
                            <!-- Send -->
                        </Grid.ColumnDefinitions>

                        <!-- TextBox + overlay placeholder -->
                        <Grid Grid.Column="0" Margin="0,0,10,0">
                            <TextBox x:Name="Input" Height="36"/>
                            <TextBlock Text="Type a message..."
                                       Margin="10,8,0,0"
                                       Foreground="#66FFFFFF"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=Input}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <Button Grid.Column="1"
                                Content="Share..."
                                Click="SharePmFile_Click"
                                Margin="0,0,10,0"/>

                        <Button Grid.Column="2"
                                Content="Send"
                                Click="Send_Click"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Files panel -->
            <Border Grid.Column="2" Background="#221F1F" Padding="12" CornerRadius="14" BorderBrush="#333" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="#AA000000" BlurRadius="10" ShadowDepth="2"/>
                </Border.Effect>
                <StackPanel>
                    <DockPanel LastChildFill="False" Margin="0,0,0,8">
                        <TextBlock Text="Shared Files" Foreground="#EEEEEE" FontSize="15" FontWeight="Bold" DockPanel.Dock="Left"/>
                        <Button Content="Save Selected..." Width="150" Height="34" Click="SaveSelected_Click" DockPanel.Dock="Right"/>
                    </DockPanel>

                    <Border Background="#151515" CornerRadius="10">
                        <ListBox x:Name="PmFilesList"
                                 Height="360"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="#E0E0E0"
                                 ItemsSource="{Binding PmFileNames}"
                                 ItemContainerStyle="{StaticResource SelectableItemStyle}"
                                 ItemTemplate="{StaticResource FileRowTemplate}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.CanContentScroll="True"/>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
