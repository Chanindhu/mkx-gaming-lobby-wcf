<Window x:Class="MKX.Lobby.Client.Polling.RoomWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:local="clr-namespace:MKX.Lobby.Client.Polling"
        Title="Room (Polling)"
        Height="640" Width="980"
        WindowStartupLocation="CenterScreen"
        Background="Black"
        DataContext="{Binding RelativeSource={RelativeSource Self}}">

    <!-- ===== Styles & resources ===== -->
    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#E4B900"/>

        <!-- Converter used to detect current user -->
        <local:IsMeConverter x:Key="IsMeConverter"/>

        <!-- Base button style -->
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="10" Background="{TemplateBinding Background}">
                            <Border.Effect>
                                <DropShadowEffect Color="#66000000" BlurRadius="10" ShadowDepth="2"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFF0CB20"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#FFD8B800"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small button variant (header) -->
        <Style x:Key="SmallBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="MinWidth" Value="100"/>
        </Style>

        <!-- TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="#F0F0F0"/>
            <Setter Property="BorderBrush" Value="#404040"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <!-- Card -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Background" Value="#CC181818"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#99000000" BlurRadius="20" ShadowDepth="4"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Chat items -->
        <Style x:Key="ChatItemStyle" TargetType="ListBoxItem">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" CornerRadius="10" Padding="10" Background="#12000000">
                            <!-- Use TemplateBinding so we never search for an ancestor -->
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                <Setter TargetName="bd" Property="Background" Value="#1E000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Selectable items (Users/Files) -->
        <Style x:Key="SelectableItemStyle" TargetType="ListBoxItem">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="6,4"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#F0F0F0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd"
                                CornerRadius="10"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource Accent}"
                                BorderThickness="0"
                                Padding="{TemplateBinding Padding}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="scale" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>

                            <!-- Use TemplateBinding to avoid ancestor lookups -->
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#22111111"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#442D2D2D"/>
                                <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="scale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1.02" Duration="0:0:0.10"/>
                                            <DoubleAnimation Storyboard.TargetName="scale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1.02" Duration="0:0:0.10"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="scale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1.00" Duration="0:0:0.10"/>
                                            <DoubleAnimation Storyboard.TargetName="scale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1.00" Duration="0:0:0.10"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Row template for files -->
        <DataTemplate x:Key="FileRowTemplate">
            <DockPanel LastChildFill="True">
                <TextBlock Text="Attachment" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding}" Foreground="White"/>
            </DockPanel>
        </DataTemplate>

        <!-- Chat line (string) -->
        <DataTemplate DataType="{x:Type sys:String}">
            <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
        </DataTemplate>

        <!-- File link item (clickable) -->
        <DataTemplate DataType="{x:Type local:FileLinkItem}">
            <TextBlock TextWrapping="Wrap">
                <Run Text="["/>
                <Run Text="{Binding At, StringFormat=HH:mm}"/>
                <Run Text="] "/>
                <Run Text="{Binding From}"/>
                <Run Text=" shared "/>
                <Hyperlink Click="ChatFileLink_Click" Tag="{Binding}">
                    <Run Text="{Binding FileName}"/>
                </Hyperlink>
            </TextBlock>
        </DataTemplate>

        <!-- Users row template with 'YOU' badge -->
        <DataTemplate x:Key="UserRowTemplate" DataType="{x:Type sys:String}">
            <Border x:Name="Row" Background="Transparent" Padding="0">
                <DockPanel LastChildFill="True">
                    <Border x:Name="YouBadge"
                            Background="{StaticResource Accent}"
                            CornerRadius="6"
                            Padding="6,2"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Visibility="Collapsed"
                            DockPanel.Dock="Right">
                        <TextBlock Text="YOU" Foreground="Black" FontWeight="Bold"/>
                    </Border>

                    <TextBlock x:Name="UserNameText"
                               Text="{Binding}"
                               Foreground="White"
                               FontSize="14"
                               VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <DataTemplate.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource IsMeConverter}">
                            <Binding/>
                            <Binding RelativeSource="{RelativeSource AncestorType=local:RoomWindow}" Path="Me"/>
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter TargetName="YouBadge" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="UserNameText" Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <!-- Background -->
        <Grid.Background>
            <ImageBrush ImageSource="/Assets/Room.jpg" Stretch="UniformToFill"/>
        </Grid.Background>

        <!-- Overlay -->
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#80000000" Offset="0"/>
                    <GradientStop Color="#99000000" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Foreground layout -->
        <Grid Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource Card}" Padding="10" Margin="0,0,0,12">
                <DockPanel LastChildFill="False">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <TextBlock Text="Room controls" Foreground="#DDDDDD" Margin="4,2,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Button Style="{StaticResource SmallBtn}" Content="Leave Room" Click="Leave_Click" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource SmallBtn}" Content="Logout" Click="Logout_Click"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Chat -->
            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="Room chat" Foreground="White" FontSize="16" FontWeight="Bold" DockPanel.Dock="Left"/>
                        <Border Background="{StaticResource Accent}" CornerRadius="10" Padding="6,2" DockPanel.Dock="Right">
                            <TextBlock Foreground="Black" FontWeight="Bold"
                                       Text="{Binding ElementName=UsersList, Path=Items.Count}"/>
                        </Border>
                    </DockPanel>

                    <ListBox x:Name="ChatList"
                             Grid.Row="1"
                             MinHeight="280"
                             BorderThickness="0"
                             Background="#14000000"
                             Padding="8"
                             Foreground="White"
                             ItemContainerStyle="{StaticResource ChatItemStyle}"
                             AlternationCount="2"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.CanContentScroll="False"/>
                </Grid>
            </Border>

            <!-- Right panel: Users + Shared Files -->
            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" Margin="12,0,0,0">
                <StackPanel>
                    <TextBlock Text="Users" Foreground="White" FontSize="16" FontWeight="Bold"/>
                    <ListBox x:Name="UsersList"
                             Height="126"
                             Margin="0,6,0,12"
                             Background="#14000000"
                             BorderThickness="0"
                             Foreground="White"
                             ItemTemplate="{StaticResource UserRowTemplate}"
                             ItemContainerStyle="{StaticResource SelectableItemStyle}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.CanContentScroll="True"/>

                    <Separator Margin="0,6,0,10"/>
                    <DockPanel LastChildFill="False" Margin="0,0,0,6">
                        <TextBlock Text="Shared Files" Foreground="White" FontSize="16" FontWeight="Bold" DockPanel.Dock="Left"/>
                        <Button Content="Save Selected..." Width="140" Height="32" Click="SaveSelected_Click" DockPanel.Dock="Right"/>
                    </DockPanel>

                    <ListBox x:Name="FilesList"
                             Height="96"
                             Background="#14000000"
                             BorderThickness="0"
                             Foreground="White"
                             ItemContainerStyle="{StaticResource SelectableItemStyle}"
                             ItemTemplate="{StaticResource FileRowTemplate}"
                             ItemsSource="{Binding FileNames}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.CanContentScroll="True"/>
                </StackPanel>
            </Border>

            <!-- Input row -->
            <Border Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <Grid>
                        <TextBox x:Name="MessageBoxInput"
                                 Height="40"
                                 FontSize="14"
                                 BorderThickness="0"
                                 VerticalContentAlignment="Center"
                                 Padding="12,8,12,8"/>
                        <TextBlock IsHitTestVisible="False"
                                   Margin="12,8,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="#77FFFFFF"
                                   Text="Type a message...">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text.Length, ElementName=MessageBoxInput}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button Content="Send" Width="110" Height="36" Click="Send_Click"/>
                            <Button Content="Share File..." Width="130" Height="36" Margin="8,0,0,0" Click="Share_Click"/>
                        </StackPanel>

                        <Button Grid.Column="2"
                                Content="Private Messages..."
                                Width="160" Height="36"
                                Click="Private_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Tip -->
            <TextBlock Grid.Row="3" Grid.ColumnSpan="2"
                       Foreground="#C0C0C0" Margin="4,8,0,0"
                       Text="Tip: Only images (.png/.jpg/.jpeg/.gif) or .txt files are allowed."/>
        </Grid>
    </Grid>
</Window>
